name: Build APK

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  # Релиз 2dust/AndroidLibXrayLite (внутри Xray-core той же версии).
  LIBV2RAY_VERSION: v26.9.9

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Download libv2ray.aar (Xray-core) and slim it down
        # Готовый aar весит ~62 МБ: внутри 4 ABI и geo-базы (~28 МБ), которые нам не нужны.
        # Оставляем только arm64-v8a; geoip/geosite не используются (в конфиге нет таких правил).
        run: |
          mkdir -p app/libs
          curl -fL --retry 3 -o app/libs/libv2ray.aar \
            "https://github.com/2dust/AndroidLibXrayLite/releases/download/${LIBV2RAY_VERSION}/libv2ray.aar"
          zip -d app/libs/libv2ray.aar 'assets/*' 'jni/armeabi-v7a/*' 'jni/x86/*' 'jni/x86_64/*'
          unzip -l app/libs/libv2ray.aar | grep -E "libgojni|classes.jar"
          ls -la app/libs

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Build debug APK
        run: gradle :app:assembleDebug --no-daemon --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: DostupVPN-debug-apk
          path: app/build/outputs/apk/debug/*.apk
